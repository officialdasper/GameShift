<UserControl x:Class="GameShift.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameShift.App.Localization"
             xmlns:theme="clr-namespace:GameShift.App.Theme">
  <UserControl.Resources>
    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
      <Setter Property="Margin" Value="0,30,0,10"/>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,24,0"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" theme:ScrollShade.Brush="{DynamicResource PageShadeBrush}">
    <StackPanel Margin="36,26,28,28" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T Settings_Title}"/>

      <TextBlock Style="{StaticResource CardTitle}" Text="{loc:T Settings_GameModes}" Margin="0,22,0,10"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <CheckBox Content="{loc:T Settings_Power}" IsChecked="{Binding PowerEnabled}"/>
          <Border Style="{StaticResource Divider}"/>
          <CheckBox IsChecked="{Binding FocusEnabled}" IsEnabled="{Binding FocusSupported}">
            <StackPanel>
              <TextBlock Text="{loc:T Settings_Focus}"/>
              <TextBlock Style="{StaticResource Hint}" Text="{loc:T Settings_FocusUnsupported}"
                         Visibility="{Binding FocusUnsupportedVisibility}"/>
            </StackPanel>
          </CheckBox>
          <Border Style="{StaticResource Divider}"/>
          <CheckBox IsChecked="{Binding MemoryPurgeEnabled}">
            <StackPanel>
              <TextBlock Text="{loc:T Settings_Memory}"/>
              <TextBlock Style="{StaticResource Hint}" Text="{loc:T Settings_MemoryHint}"/>
            </StackPanel>
          </CheckBox>
          <Border Style="{StaticResource Divider}"/>
          <CheckBox Content="{loc:T Settings_AutoSwitch}" IsChecked="{Binding AutoSwitchEnabled}"/>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource CardTitle}" Text="{loc:T Settings_General}"/>
      <Border Style="{StaticResource Card}">
        <CheckBox IsChecked="{Binding StartWithWindows}">
          <StackPanel>
            <TextBlock Text="{loc:T Settings_Autostart}"/>
            <TextBlock Style="{StaticResource Hint}" Text="{loc:T Settings_AutostartHint}"/>
          </StackPanel>
        </CheckBox>
      </Border>

      <TextBlock Style="{StaticResource CardTitle}" Text="{loc:T Settings_Appearance}"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource RowLabel}" Text="{loc:T Settings_Theme}"/>
            <Border Grid.Column="1" Style="{StaticResource SegmentTrack}">
              <theme:SegmentPanel Style="{StaticResource SegmentRow}">
                <RadioButton Style="{StaticResource Segment}" GroupName="theme" Content="{loc:T Common_System}" IsChecked="{Binding IsThemeSystem}"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="theme" Content="{loc:T Theme_Dark}" IsChecked="{Binding IsThemeDark}"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="theme" Content="{loc:T Theme_Light}" IsChecked="{Binding IsThemeLight}"/>
              </theme:SegmentPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Margin="0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
              <TextBlock Text="{loc:T Settings_Backdrop}"/>
              <TextBlock Style="{StaticResource Hint}" Text="{loc:T Settings_BackdropHint}"
                         Visibility="{Binding BackdropUnsupportedVisibility}"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource SegmentTrack}" IsEnabled="{Binding BackdropSupported}">
              <theme:SegmentPanel Style="{StaticResource SegmentRow}">
                <RadioButton Style="{StaticResource Segment}" GroupName="backdrop" Content="Mica" IsChecked="{Binding IsBackdropMica}"
                             ToolTip="{loc:T Backdrop_MicaTip}"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="backdrop" Content="Acrylic" IsChecked="{Binding IsBackdropAcrylic}"
                             ToolTip="{loc:T Backdrop_AcrylicTip}"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="backdrop" Content="{loc:T Backdrop_None}" IsChecked="{Binding IsBackdropNone}"
                             ToolTip="{loc:T Backdrop_NoneTip}"/>
              </theme:SegmentPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Margin="0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource RowLabel}" Text="{loc:T Settings_Accent}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource SegmentTrack}" Margin="0,0,14,0">
                <theme:SegmentPanel Style="{StaticResource SegmentRow}">
                  <RadioButton Style="{StaticResource Segment}" GroupName="accent" IsChecked="{Binding SystemAccentOption.IsChecked}">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="10" Height="10" Fill="{Binding SystemAccentOption.Brush}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                      <TextBlock Text="{Binding SystemAccentOption.Name}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </RadioButton>
                </theme:SegmentPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding AccentOptions}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton Style="{StaticResource Swatch}" GroupName="accent" Background="{Binding Brush}"
                                 IsChecked="{Binding IsChecked}" ToolTip="{Binding Name}"
                                 AutomationProperties.Name="{Binding Name}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{StaticResource CustomSwatch}" Command="{Binding PickCustomAccentCommand}"
                      Background="{Binding CustomAccentBrush}" Tag="{Binding IsCustomAccent}"
                      ToolTip="{loc:T Accent_Custom}" AutomationProperties.Name="{loc:T Accent_Custom}"/>
            </StackPanel>
          </Grid>
          <Border Style="{StaticResource Divider}"/>
          <Grid Margin="0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource RowLabel}" Text="{loc:T Settings_Language}"/>
            <ComboBox Grid.Column="1" Style="{StaticResource Picker}" ItemsSource="{Binding LanguageOptions}"
                      SelectedValuePath="Code" SelectedValue="{Binding LanguageSetting}"
                      AutomationProperties.Name="{loc:T Settings_Language}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" TextWrapping="NoWrap"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource CardTitle}" Text="NVIDIA"/>
      <Border Style="{StaticResource Card}" Padding="20,16,20,18">
        <StackPanel>
          <TextBlock Foreground="{DynamicResource SubtleBrush}"
                     Text="{loc:T Settings_NvidiaDescription}"/>
          <ItemsControl ItemsSource="{Binding NvidiaSettingNames}" Margin="0,12,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Margin="0,3"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{loc:T Settings_NvidiaMissing}" Foreground="{DynamicResource DangerBrush}" Margin="0,12,0,0"
                     Visibility="{Binding NvidiaUnavailableVisibility}"/>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Style="{StaticResource AccentButton}" Content="{loc:T Settings_NvidiaApply}" Command="{Binding ApplyNvidiaCommand}"/>
            <Button Style="{StaticResource ActionButton}" Content="{loc:T Settings_NvidiaRestore}" Command="{Binding RestoreNvidiaCommand}"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding NvidiaReport}" ItemTemplate="{StaticResource StepRowTemplate}"
                        Margin="0,10,0,0" Focusable="False"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
