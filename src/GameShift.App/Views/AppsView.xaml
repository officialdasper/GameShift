<UserControl x:Class="GameShift.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameShift.App.Localization"
             xmlns:theme="clr-namespace:GameShift.App.Theme"
             x:Name="Root">
  <ScrollViewer VerticalScrollBarVisibility="Auto" theme:ScrollShade.Brush="{DynamicResource PageShadeBrush}">
    <StackPanel Margin="36,26,28,28">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T Apps_Title}"/>
          <TextBlock Style="{StaticResource PageSubtitle}" Text="{loc:T Apps_Subtitle}"/>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource ActionButton}" Margin="16,6,0,0" VerticalAlignment="Top"
                Content="{loc:T Apps_AddRunning}" Command="{Binding AddRunningAppsCommand}"/>
      </Grid>

      <!-- Верхняя линия первой строки уходит под обрезку: ClipToBounds + отрицательный отступ. -->
      <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="20,2,12,2">
        <Grid ClipToBounds="True">
        <ItemsControl ItemsSource="{Binding Apps}" Margin="0,-1,0,0" Style="{StaticResource ListWithEmpty}"
                      Tag="{loc:T Apps_Empty}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="Row" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource RemoveButton}" Content="&#xE711;" Margin="8,0,0,0"
                          VerticalAlignment="Center" ToolTip="{loc:T Common_Remove}" AutomationProperties.Name="{loc:T Common_Remove}"
                          Command="{Binding DataContext.RemoveAppCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                  <WrapPanel>
                  <StackPanel Width="210" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="{Binding ExeName}">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ExeName}" Style="{StaticResource Hint}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Border Style="{StaticResource SegmentTrack}" Margin="0,3">
                    <theme:SegmentPanel Style="{StaticResource SegmentRow}">
                      <RadioButton Style="{StaticResource Segment}" GroupName="{Binding Group}" Content="{loc:T Apps_RuleCloseRestore}"
                                   IsChecked="{Binding IsCloseAndRestore}"/>
                      <RadioButton Style="{StaticResource Segment}" GroupName="{Binding Group}" Content="{loc:T Apps_RuleCloseOnly}"
                                   IsChecked="{Binding IsCloseOnly}"/>
                      <RadioButton Style="{StaticResource Segment}" GroupName="{Binding Group}" Content="{loc:T Apps_RuleKeep}"
                                   IsChecked="{Binding IsKeepRunning}"/>
                    </theme:SegmentPanel>
                  </Border>
                  </WrapPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
