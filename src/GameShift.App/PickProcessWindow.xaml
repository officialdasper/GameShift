<Window x:Class="GameShift.App.PickProcessWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GameShift.App.Localization"
        Width="440" Height="500" MinWidth="360" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <Style x:Key="PickItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="6" Padding="10,7" Margin="0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1.5"
                        BorderBrush="{DynamicResource MutedBrush}" HorizontalAlignment="Left">
                  <TextBlock x:Name="Check" Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="10"
                             HorizontalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}" Visibility="Hidden"/>
                </Border>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource RaisedBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Margin="20,16,20,20">
    <TextBlock x:Name="Hint" DockPanel.Dock="Top" Foreground="{DynamicResource SubtleBrush}" Margin="0,0,0,12"
               Text="{loc:T Pick_Hint}"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Style="{StaticResource ActionButton}" Content="{loc:T Common_Cancel}" IsCancel="True"/>
      <Button Style="{StaticResource AccentButton}" Content="{loc:T Common_Add}" IsDefault="True" Margin="0" Click="OnAdd"/>
    </StackPanel>
    <Border Style="{StaticResource Card}" Padding="6">
      <ListBox x:Name="List" SelectionMode="Multiple" Background="Transparent" BorderThickness="0"
               Foreground="{DynamicResource TextBrush}" ItemContainerStyle="{StaticResource PickItem}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </Border>
  </DockPanel>
</Window>
