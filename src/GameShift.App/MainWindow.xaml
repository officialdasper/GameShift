<Window x:Class="GameShift.App.MainWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GameShift.App.Localization"
        xmlns:views="clr-namespace:GameShift.App.Views"
        xmlns:theme="clr-namespace:GameShift.App.Theme"
        Title="GameShift" Icon="Assets/GameShift.ico" Width="960" Height="600" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="NavItem" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid Height="40" Margin="0,1">
              <Border x:Name="Hover" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" Opacity="0"/>
              <Border x:Name="Ring" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
                      Visibility="Collapsed"/>
              <StackPanel Orientation="Horizontal" Margin="14,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="Glyph" Style="{StaticResource Glyph}" FontSize="16"
                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                <ContentPresenter ContentSource="Header" Margin="12,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1"
                                       Duration="{theme:Ms 120}" EasingFunction="{StaticResource EaseOut}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0"
                                       Duration="{theme:Ms 200}" EasingFunction="{StaticResource EaseOut}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="theme:FocusCue.Visible" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <TabControl x:Name="Tabs" ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0"
              Foreground="{DynamicResource TextBrush}" FocusVisualStyle="{x:Null}">
    <TabControl.Template>
      <ControlTemplate TargetType="TabControl">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,0">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,20,0,22">
                <!-- Знак вектором: шевроны цвета акцента и перекрашиваются вместе с ним. -->
                <Viewbox Width="28" Height="28">
                  <Grid Width="256" Height="256">
                    <Border CornerRadius="52" Background="#151515"/>
                    <Path Data="{x:Static theme:BrandMark.Chevrons}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="44"
                          StrokeLineJoin="Miter" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"/>
                  </Grid>
                </Viewbox>
                <TextBlock Text="GameShift" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                           Margin="10,0,0,1" VerticalAlignment="Center" TextWrapping="NoWrap"/>
              </StackPanel>

              <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                      Margin="4,0" Padding="4,14,4,18">
                <StackPanel>
                  <TextBlock Text="{loc:T Nav_CurrentMode}" FontSize="12" Foreground="{DynamicResource SubtleBrush}"/>
                  <TextBlock Text="{Binding ModeTitle}" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Border>

              <Grid VerticalAlignment="Top">
                <StackPanel x:Name="PART_Items" IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"
                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                <Border x:Name="PART_Bar" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Background="{DynamicResource AccentBrush}" IsHitTestVisible="False"
                        Opacity="0">
                  <Border.RenderTransform>
                    <TranslateTransform/>
                  </Border.RenderTransform>
                </Border>
              </Grid>
            </DockPanel>
          </Border>

          <Border Grid.Column="1" Background="{DynamicResource PageBrush}">
            <ContentPresenter x:Name="PART_Page" ContentSource="SelectedContent">
              <ContentPresenter.RenderTransform>
                <TranslateTransform/>
              </ContentPresenter.RenderTransform>
            </ContentPresenter>
          </Border>
        </Grid>
      </ControlTemplate>
    </TabControl.Template>

    <TabItem Header="{loc:T Nav_Mode}" Tag="&#xE945;"><views:ModeView/></TabItem>
    <TabItem Header="{loc:T Nav_Apps}" Tag="&#xE71D;"><views:AppsView/></TabItem>
    <TabItem Header="{loc:T Nav_Games}" Tag="&#xE7FC;"><views:GamesView/></TabItem>
    <TabItem Header="{loc:T Nav_Settings}" Tag="&#xE713;"><views:SettingsView/></TabItem>
  </TabControl>
</Window>
