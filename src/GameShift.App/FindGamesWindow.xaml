<Window x:Class="GameShift.App.FindGamesWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GameShift.App.Localization"
        xmlns:theme="clr-namespace:GameShift.App.Theme"
        Width="680" Height="580" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <Style x:Key="RowCheck" TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5"
                      BorderBrush="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="Check" Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource OnAccentBrush}" Visibility="Hidden"/>
              </Border>
              <Border x:Name="Ring" Margin="-3" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
                      Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="theme:FocusCue.Visible" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="FoundRow">
      <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="8,7" Margin="0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <CheckBox Style="{StaticResource RowCheck}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanToggle}"
                    VerticalAlignment="Center" ToolTip="{loc:T Common_Add}" AutomationProperties.Name="{Binding Name}"/>

          <Border Grid.Column="1" Width="92" Height="43" CornerRadius="4" Background="{DynamicResource RaisedBrush}"
                  HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid>
              <Border x:Name="ArtBox" CornerRadius="4" Visibility="Collapsed">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border.Background>
              </Border>
              <Grid x:Name="IconBox" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="Fallback" Style="{StaticResource Glyph}" Text="&#xE7FC;" FontSize="24"
                           Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
                <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
            </Grid>
          </Border>

          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,12,0" ToolTip="{Binding FolderText}">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource SubtleBrush}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
            <TextBlock x:Name="Listed" Text="{loc:T Scan_Listed}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                       Margin="0,2,0,0" Visibility="Collapsed"/>
          </StackPanel>

          <Button Grid.Column="3" Style="{StaticResource ActionButton}" Content="{loc:T Games_PickExe}" Margin="0"
                  Padding="12,5" FontSize="12.5" VerticalAlignment="Center"
                  Click="OnPickExe" Tag="{Binding}"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Art, Converter={StaticResource IsNotNull}}" Value="True">
          <Setter TargetName="ArtBox" Property="Visibility" Value="Visible"/>
          <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
          <Setter TargetName="Fallback" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding AlreadyAdded}" Value="True">
          <Setter TargetName="Listed" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Row" Property="Opacity" Value="0.7"/>
        </DataTrigger>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource RaisedBrush}"/>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="20,16,20,20">
    <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource SubtleBrush}" Text="{loc:T Scan_Hint}"/>

    <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{loc:T Scan_Searching}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
      <Grid Height="2" ClipToBounds="True">
        <Border Background="{DynamicResource AccentBrush}" Opacity="0.25"/>
        <Border Background="{DynamicResource AccentBrush}" Visibility="{x:Static theme:Motion.WhenEnabled}">
          <Border.OpacityMask>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <LinearGradientBrush.RelativeTransform>
                <TranslateTransform x:Name="RunnerShift" X="-0.7"/>
              </LinearGradientBrush.RelativeTransform>
              <GradientStop Color="Transparent" Offset="0.35"/>
              <GradientStop Color="Black" Offset="0.35"/>
              <GradientStop Color="Black" Offset="0.65"/>
              <GradientStop Color="Transparent" Offset="0.65"/>
            </LinearGradientBrush>
          </Border.OpacityMask>
        </Border>
        <Border Background="{DynamicResource AccentBrush}" Opacity="0.6" Visibility="{x:Static theme:Motion.WhenDisabled}"/>
      </Grid>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Style="{StaticResource ActionButton}" Content="{loc:T Common_Cancel}" IsCancel="True"/>
      <Button Style="{StaticResource AccentButton}" Content="{loc:T Scan_AddSelected}" IsDefault="True" Margin="0"
              IsEnabled="{Binding CanAdd}" Click="OnAdd"/>
    </StackPanel>

    <Border Style="{StaticResource Card}" Padding="6" Margin="0,12,0,0">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource FoundRow}" Focusable="False"/>
        </ScrollViewer>
        <TextBlock Text="{loc:T Scan_Empty}" Foreground="{DynamicResource SubtleBrush}" Margin="10,12"
                   VerticalAlignment="Top" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
      </Grid>
    </Border>
  </DockPanel>
</Window>
