<Window x:Class="GameShift.App.SwitchAppsWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GameShift.App.Localization"
        xmlns:theme="clr-namespace:GameShift.App.Theme"
        Title="GameShift" Width="640" MinWidth="520" SizeToContent="Height" ResizeMode="CanMinimize"
        ShowInTaskbar="True" ShowActivated="True">
  <Window.Resources>
    <Style x:Key="PickRow" TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Margin="0,1">
              <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5"
                          BorderBrush="{DynamicResource MutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid>
                      <TextBlock x:Name="Check" Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="11"
                                 HorizontalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}" Visibility="Hidden"/>
                      <Border x:Name="Dash" Width="8" Height="2" CornerRadius="1" Background="{DynamicResource OnAccentBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
                    </Grid>
                  </Border>
                  <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Border x:Name="Ring" CornerRadius="8" Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
                      Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource RaisedBrush}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SubtleBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Dash" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="theme:FocusCue.Visible" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="AppIcon">
      <Grid Width="24" Height="24">
        <TextBlock x:Name="Fallback" Style="{StaticResource Glyph}" Text="&#xE71D;" FontSize="18" HorizontalAlignment="Center"
                   Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
        <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
          <Setter TargetName="Fallback" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="PickContent">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AppIcon}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding FileName}" ToolTip="{Binding Path}" FontSize="12" Foreground="{DynamicResource SubtleBrush}"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" HorizontalAlignment="Left"/>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PickItem">
      <CheckBox Style="{StaticResource PickRow}" IsChecked="{Binding IsChecked}" Content="{Binding}"
                ContentTemplate="{StaticResource PickContent}" AutomationProperties.Name="{Binding Name}"/>
    </DataTemplate>

    <DataTemplate x:Key="ProgressItem">
      <Border x:Name="Row" Padding="10,8" Margin="0,1" CornerRadius="6" Background="Transparent">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StateGlyph" Style="{StaticResource Glyph}" Text="&#xE823;" FontSize="14"
                     Foreground="{DynamicResource MutedBrush}"/>
          <ContentPresenter x:Name="Icon" Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource AppIcon}"
                            VerticalAlignment="Center"/>
          <StackPanel x:Name="Texts" Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="StateLine" Text="{Binding StateText}" FontSize="12" Foreground="{DynamicResource SubtleBrush}"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="{Binding ShowActions, Converter={StaticResource BoolToVisibility}}">
            <Button Style="{StaticResource ActionButton}" Content="{loc:T Close_Kill}" Padding="10,5" FontSize="12.5"
                    Click="OnKill" Tag="{Binding}"/>
            <Button Style="{StaticResource ActionButton}" Content="{loc:T Close_Leave}" Padding="10,5" FontSize="12.5"
                    Margin="0" Click="OnLeave" Tag="{Binding}"/>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsClosed}" Value="True">
          <Setter TargetName="StateGlyph" Property="Text" Value="&#xE73E;"/>
          <Setter TargetName="StateGlyph" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Texts" Storyboard.TargetProperty="Opacity" To="0.6"
                                 Duration="{theme:Ms 200}" EasingFunction="{StaticResource EaseOut}"/>
                <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" To="0.6"
                                 Duration="{theme:Ms 200}" EasingFunction="{StaticResource EaseOut}"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsLeft}" Value="True">
          <Setter TargetName="StateGlyph" Property="Text" Value="&#xE738;"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsFailed}" Value="True">
          <Setter TargetName="StateGlyph" Property="Text" Value="&#xE711;"/>
          <Setter TargetName="StateGlyph" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
          <Setter TargetName="StateLine" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding ShowActions}" Value="True">
          <Setter TargetName="StateGlyph" Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="24,20,24,20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}"/>
      <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Subtitle}" Margin="0,6,0,0" MaxWidth="560"/>
    </StackPanel>

    <Grid DockPanel.Dock="Top" Height="2" Margin="0,14,0,0" ClipToBounds="True"
          Visibility="{Binding IsClosing, Converter={StaticResource BoolToVisibility}}">
      <Border Background="{DynamicResource AccentBrush}" Opacity="0.25"/>
      <Border Background="{DynamicResource AccentBrush}" Visibility="{x:Static theme:Motion.WhenEnabled}">
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <LinearGradientBrush.RelativeTransform>
              <TranslateTransform x:Name="RunnerShift" X="-0.7"/>
            </LinearGradientBrush.RelativeTransform>
            <GradientStop Color="Transparent" Offset="0.35"/>
            <GradientStop Color="Black" Offset="0.35"/>
            <GradientStop Color="Black" Offset="0.65"/>
            <GradientStop Color="Transparent" Offset="0.65"/>
          </LinearGradientBrush>
        </Border.OpacityMask>
      </Border>
      <Border Background="{DynamicResource AccentBrush}" Opacity="0.6" Visibility="{x:Static theme:Motion.WhenDisabled}"/>
    </Grid>

    <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding IsSelect, Converter={StaticResource BoolToVisibility}}">
      <CheckBox IsChecked="{Binding Remember}" Padding="2,16,2,0">
        <StackPanel>
          <TextBlock Text="{loc:T Close_Remember}"/>
          <TextBlock Style="{StaticResource Hint}" Text="{Binding RememberHint}"/>
        </StackPanel>
      </CheckBox>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button x:Name="CancelButton" Style="{StaticResource ActionButton}" Content="{Binding CancelText}" IsCancel="True"
                Click="OnCancel"/>
        <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Content="{Binding ConfirmText}" IsDefault="True"
                Margin="0" IsEnabled="{Binding CanConfirm}" Click="OnConfirm"/>
      </StackPanel>
    </StackPanel>

    <!-- Низ: ожидание. Во время закрытия кнопки видны, но неактивны, чтобы окно не прыгало. -->
    <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,20,0,0"
               Visibility="{Binding IsProgress, Converter={StaticResource BoolToVisibility}}"
               IsEnabled="{Binding IsWaiting}">
      <Button Style="{StaticResource ActionButton}" Content="{loc:T Close_LeaveAll}" Click="OnLeaveAll" Margin="0,0,8,0"/>
      <Button Style="{StaticResource ActionButton}" Content="{loc:T Close_KillAll}" Click="OnKillAll" Margin="0,0,8,0"/>
      <Button x:Name="WaitButton" Style="{StaticResource AccentButton}" Content="{loc:T Close_WaitMore}" Click="OnWaitMore" Margin="0"/>
    </WrapPanel>

    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Text="{Binding KeptText}" Margin="2,10,0,0"
               Visibility="{Binding ShowKept, Converter={StaticResource BoolToVisibility}}"/>

    <Border Style="{StaticResource Card}" Padding="6" Margin="0,16,0,0">
      <Grid>
        <DockPanel Visibility="{Binding IsSelect, Converter={StaticResource BoolToVisibility}}">
          <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
            <CheckBox x:Name="AllBox" Style="{StaticResource PickRow}" IsChecked="{Binding AllChecked}"
                      AutomationProperties.Name="{loc:T Close_SelectAll}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="12.5" Foreground="{DynamicResource SubtleBrush}"
                           TextWrapping="NoWrap" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:T Close_SelectAll}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
              </DockPanel>
            </CheckBox>
            <Border Style="{StaticResource Divider}" Margin="10,2,10,2"/>
          </StackPanel>
          <TextBlock Style="{StaticResource Hint}" Text="{Binding EmptyText}" Margin="10,12,10,12"
                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
          <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Focusable="False"
                        Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl x:Name="PickList" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource PickItem}" Focusable="False"/>
          </ScrollViewer>
        </DockPanel>
        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding IsProgress, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl ItemsSource="{Binding Progress}" ItemTemplate="{StaticResource ProgressItem}" Focusable="False"/>
        </ScrollViewer>
      </Grid>
    </Border>
  </DockPanel>
</Window>
